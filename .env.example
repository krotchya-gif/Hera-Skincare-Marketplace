# ── Wajib ────────────────────────────────────────────────────────────────────
# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key

# Base URL publik — dipakai sitemap.xml & robots.txt (fallback: request host)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Pembayaran online (Xendit Invoice, T-02) ─────────────────────────────────
# Kosongkan = fitur bayar online nonaktif; transfer manual tetap berfungsi.
# Secret key & callback token dari Dashboard Xendit (Development/Live sesuai mode).
# SUPABASE_SERVICE_ROLE_KEY wajib untuk webhook (server-side only, jangan NEXT_PUBLIC).
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# ── Opsional — fallback hardcoded ada di src/utils/storeConfig.ts ────────────
NEXT_PUBLIC_STORE_NAME=Hera Skincare
NEXT_PUBLIC_STORE_EMAIL=info@heraskincare.com
NEXT_PUBLIC_STORE_PHONE=+6281234567890
NEXT_PUBLIC_STORE_DESCRIPTION=Marketplace skincare & perawatan pribadi
NEXT_PUBLIC_STORE_ADDRESS=Alamat toko Anda
